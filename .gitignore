# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env*.example

# vercel
.vercel

# graphify generated output
/graphify-out/

# typescript
*.tsbuildinfo
next-env.d.ts

# local tooling artifacts (e.g. a downloaded cloudflared binary/archive for
# local tunnel testing) - never part of this application's source or build
/cloudflared
/cloudflared.tgz
