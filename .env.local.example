# Supabase project URL (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anonymous/public API key (Project Settings > API)
# Safe for browser use; RLS policies enforce access control.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service-role key (Project Settings > API).
# SERVER-ONLY - never prefix with NEXT_PUBLIC_, never send to the browser.
# Used exclusively by app/api/automation/n8n-callback, which has no user
# session to authenticate with (n8n authenticates via N8N_WEBHOOK_SECRET
# instead) and bypasses RLS accordingly.
SUPABASE_SERVICE_ROLE_KEY=

# Base URL of the n8n instance that receives Trackpr's automation dispatches.
# SERVER-ONLY. If unset, automation dispatch is recorded as a failed
# execution rather than silently no-oping.
N8N_BASE_URL=

# Shared secret used both ways: sent as a header when Trackpr calls n8n, and
# required as a header on n8n's callback into Trackpr. SERVER-ONLY.
N8N_WEBHOOK_SECRET=
